<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:background="@drawable/border_dialog"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@drawable/border_dialog"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- Message Text -->
        <TextView
            android:id="@+id/msgTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/noFingerprintExceptionMsg"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Spinner -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/spinnerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/msgTxt"
            android:layout_marginBottom="16dp"
            android:elevation="8dp"
            app:boxBackgroundMode="outline"
            app:endIconMode="dropdown_menu"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:inputType="none"
                android:clickable="true"
                android:focusable="false"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Other Reason EditText - Now positioned below spinner -->
        <EditText
            android:id="@+id/otherReasonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/spinnerContainer"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:padding="8dp"
            android:minHeight="48dp"
            android:background="@drawable/border"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:hint="Enter reason"
            android:textSize="16sp" />

        <!-- Button Container with Colored Material Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/otherReasonText"
            android:orientation="horizontal"
            android:weightSum="2"
            android:paddingTop="8dp">

            <!-- Green OK Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/okBtn"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="OK"
                android:textSize="16sp"
                android:backgroundTint="@drawable/btn_green_selector"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_check_white"
                app:iconTint="@android:color/white" />

            <!-- Red Close Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/closeBtn"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Close"
                android:textSize="16sp"
                android:backgroundTint="@drawable/btn_red_selector"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_close_white"
                app:iconTint="@android:color/white" />
        </LinearLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>